# ============================================================
# Xilinx Vivado .gitignore
# Keep RTL sources, constraints and project definition.
# Ignore generated files, caches, simulation and build results.
# ============================================================

# Vivado generated directories
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/

# Vivado temporary directories
.Xil/
.Xilinx/

# Vivado logs / journals
vivado.log
vivado.jou
vivado_*.log
vivado_*.jou

# General logs
*.log
*.jou

# Simulation generated files
*.wdb
*.wcfg
*.vcd
*.fst

# Simulation directories / executables
xsim.dir/
simv
simv.daidir/

# Synthesis / implementation generated files
*.dcp
*.bit
*.bin
*.ltx
*.mmi

# Reports generated by Vivado
*.rpt
*.rpx

# Generated databases / intermediate files
*.pb
*.str
*.xml.tmp

# WebTalk
usage_statistics_webtalk.*
webtalk.*
.webtalk/

# IP generated products
*.veo
*.vho
*.xci.lock

# Temporary / backup files
*~
*.tmp
*.temp
*.bak
*.backup
*.orig

# Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Python cache (if test scripts are added later)
__pycache__/
*.pyc
*.pyo
